# Throttle requests per client IP to slow down basic-auth brute-forcing.
limit_req_zone $binary_remote_addr zone=proxy_limit:10m rate=10r/s;

server {
    listen ${LISTEN_PORT};
    server_name ${SERVER_NAME};

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    auth_basic "${AUTH_REALM}";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        limit_req zone=proxy_limit burst=20 nodelay;
        proxy_pass http://${BACKEND_URL};
        proxy_set_header Host ${BACKEND_URL};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_connect_timeout ${BACKEND_TIMEOUT}s;
        proxy_send_timeout ${BACKEND_TIMEOUT}s;
        proxy_read_timeout ${BACKEND_TIMEOUT}s;
    }
}
